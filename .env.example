GEMINI_API_KEY=
# Password for /admin. The panel stays off until this is set.
ADMIN_PASSWORD=
# Postgres connection for hosted deployments. Without it, edits save to data/site.json.
DATABASE_URL=
# Resend key for the contact form. Sign up with the address that should receive messages.
RESEND_API_KEY=
# Public site URL, used for SEO links. Optional on Vercel.
NEXT_PUBLIC_SITE_URL=
# Optional: send contact messages here instead of the email set in /admin.
CONTACT_TO=
# Optional: the timezone for daily analytics totals. Defaults to Asia/Kolkata.
ANALYTICS_TIMEZONE=
